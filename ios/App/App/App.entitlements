<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for Apple FamilyControls / ManagedSettings / DeviceActivity APIs.
	     Must be paired with the Family Controls capability provisioned in
	     App Store Connect / your Apple Developer account. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- App Group enables sharing managed-settings stores between the host app
	     and any ManagedSettings / DeviceActivity extensions. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.reforged.discipline.shield</string>
	</array>
</dict>
</plist>
